# AWS
AWS_REGION=us-east-1
# Use `aws configure` or standard AWS env vars (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# for credentials -- do not put access keys in this file.

# Bedrock model ids. Nova Micro's id is stable and confirmed below.
# The Claude ids drift as new versions ship -- run this before filling them in:
#   aws bedrock list-foundation-models --by-provider anthropic --query "modelSummaries[].modelId" --region us-east-1
# Newer Claude models reject bare model ids for on-demand Converse calls
# ("... isn't supported. Retry with an inference profile id") -- you need the
# us.*/global.* prefixed inference-profile id instead. List them with:
#   aws bedrock list-inference-profiles --region us-east-1 --query "inferenceProfileSummaries[?contains(inferenceProfileId,'claude')].inferenceProfileId"
# Note some listed ids (e.g. a brand new "sonnet-5") can still 403 with
# AccessDeniedException even with the profile prefix, if your account isn't
# entitled to that specific model yet -- fall back to an older Sonnet
# profile that succeeds when you test it.
MODEL_ID_LOW=amazon.nova-micro-v1:0
MODEL_ID_MEDIUM=REPLACE_WITH_CURRENT_CLAUDE_HAIKU_INFERENCE_PROFILE_ID
MODEL_ID_HIGH=REPLACE_WITH_CURRENT_CLAUDE_SONNET_INFERENCE_PROFILE_ID
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Routing
ESCALATION_CONFIDENCE_THRESHOLD=0.55
MAX_ESCALATIONS=2

# Retrieval
FAISS_INDEX_DIR=app/data/faiss_index
RETRIEVAL_TOP_K=4

# Output token ceilings per pipeline stage -- too low and long/multi-part
# messages get cut off mid-answer (or the segmenter's JSON gets cut off,
# which silently falls back to treating the whole message as one sub-task).
# Per-tier because a high-tier sub-task ("design a full system architecture")
# needs far more headroom than a low-tier one (a quick fact or arithmetic).
MAX_TOKENS_SEGMENT=2048
MAX_TOKENS_ANSWER_LOW=2048
MAX_TOKENS_ANSWER_MEDIUM=4096
MAX_TOKENS_ANSWER_HIGH=16000
MAX_TOKENS_ASSEMBLE=4096
ASSEMBLE_MERGE_MAX_SUBTASKS=4

# Pricing, USD per 1K tokens (in,out) -- keep in sync with whatever MODEL_ID_* actually resolve to.
# Check https://aws.amazon.com/bedrock/pricing/ before trusting these for real budget tracking.
PRICE_LOW_IN=0.000035
PRICE_LOW_OUT=0.00014
PRICE_MEDIUM_IN=0.0008
PRICE_MEDIUM_OUT=0.004
PRICE_HIGH_IN=0.003
PRICE_HIGH_OUT=0.015
